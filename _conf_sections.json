{
  "sections": [
    {
      "key": "qwen_basic",
      "description": "预设与恢复",
      "hint": "用于恢复默认配置。",
      "items": [
        "reset_to_defaults"
      ]
    },
    {
      "key": "qwen_comfyui_connection",
      "description": "ComfyUI 连接",
      "hint": "用于连接 ComfyUI。通常请先用绘世启动器、ComfyUI portable 或自己的方式启动 ComfyUI；AstrBot 在服务器时请填写本机的局域网或 Tailscale 地址。只有 AstrBot 和 ComfyUI 同机时，才建议开启“由 AstrBot 启动 ComfyUI”。",
      "items": [
        "comfyui_base_url",
        "workflow",
        "timeout",
        "poll_interval",
        "auto_start",
        "startup_command",
        "startup_workdir",
        "startup_visible_window",
        "auto_start_admin_only",
        "auto_start_allowed_sender_ids",
        "startup_wait_seconds",
        "startup_poll_interval"
      ]
    },
    {
      "key": "qwen_models",
      "description": "模型文件",
      "hint": "首次配置时请对照 ComfyUI 下拉框确认；这里只填文件名，不填路径。如果状态检查显示模型不可用，优先检查这里。",
      "items": [
        "unet_name",
        "clip_name",
        "vae_name"
      ]
    },
    {
      "key": "qwen_rendering",
      "description": "出图参数",
      "hint": "控制采样步数、CFG、采样器和调度器。Qwen-Image-2.1 默认 CFG 1.0；只有图中文字需要清晰时才提高 CFG 并填写负面提示词。",
      "items": [
        "allowed_sizes",
        "steps",
        "cfg",
        "sampler_name",
        "scheduler",
        "output_size_mode",
        "single_image_size_mode",
        "limit_image_megapixels",
        "output_aspect",
        "output_megapixels",
        "negative_prompt"
      ]
    },
    {
      "key": "qwen_pe",
      "description": "本地 PE 提示词增强",
      "hint": "由 ComfyUI 所在机器上的 PE GGUF 增强，不调用 AstrBot 聊天模型。",
      "items": [
        "pe_server_url",
        "pe_port",
        "pe_t2i_model",
        "pe_edit_model",
        "pe_t2i_max_tokens",
        "pe_edit_max_tokens"
      ]
    },
    {
      "key": "qwen_generation",
      "description": "文生图",
      "hint": "只响应显式 /qwen 生图；由本地 PE 自动扩写，不指定默认画风。",
      "items": [
        "t2i_enabled",
        "t2i_steps",
        "t2i_aspect",
        "t2i_megapixels"
      ]
    },
    {
      "key": "qwen_editing",
      "description": "图生图",
      "hint": "第一张为改图目标，后面为参考图（换装/融合/风格参考），最多 3 张，多余会被截断并提示。",
      "items": [
        "img2img_enabled",
        "max_image_side",
        "slot_ttl_minutes",
        "slot_scope"
      ]
    },
    {
      "key": "qwen_custom",
      "description": "自定义工作流",
      "hint": "给有 ComfyUI 经验的用户覆盖内置编辑图。先用 /qwen 验工作流 跑 8 步探针验证。",
      "items": [
        "custom_workflow_enabled",
        "custom_workflow_path",
        "custom_workflow_json"
      ]
    },
    {
      "key": "qwen_delivery",
      "description": "发送与权限",
      "hint": "控制图片是否发回聊天，以及哪些用户可以使用插件。",
      "items": [
        "send_result_to_chat",
        "max_send_images",
        "admin_only",
        "allowed_sender_ids"
      ]
    },
    {
      "key": "qwen_debug",
      "description": "排查问题",
      "hint": "只在排查问题时临时开启，平时建议保持关闭。",
      "items": [
        "debug_image_reference_enabled",
        "debug_send_payload_enabled"
      ]
    }
  ]
}
